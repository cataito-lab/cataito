# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.open-next/

# cloudflare
.wrangler/
.dev.vars

# sandbox (work-in-progress, not for commit)
sandbox-*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ===== 内部文件：绝对禁止上传到 GitHub（由 .git/hooks/pre-push 强制拦截）=====
# 运营手册、技术文档、操作卡片等所有 CATAI- 前缀文档
CATAI-*
快速操作卡片*
# 任意可视化编辑器工具（tool-editor.html / blog-editor.html 等）
*-editor.html
# AI 开发工具配置文件
AGENTS.md
CLAUDE.md
# Qoder AI 代理内部数据
.qoder/
# 项目级 AI 代理技能（内部运营流程文档，含灾备/收录政策等内部信息）
.agents/
# multi-agent 交接文件（本地-only，归档于 backup/handoff-docs 分支）
HANDOFF.md
DECISIONS.md
# 研究草稿文件
*-research.md
# 临时渲染文件
logo-hires.png
# Lighthouse 报告
*.report.html
*.report.json

# 其他内部约定：以 _internal/ 存放的任何文件、*.local.* 文件
_internal/
*.local.*
# GSC 服务账号密钥（绝对禁止上传）
gsc-key*.json
*.gsc-key.json
# GSC OAuth 客户端与授权 token（含密钥/令牌，绝对禁止上传）
gsc-oauth-client*.json
gsc-token*.json

# ===== 非上线文件：不影响 Vercel 构建，仅本地开发使用 =====
# 项目 README（GitHub 首页展示用，非构建必需）
README.md
# Next.js 默认占位 SVG（代码中未引用）
public/file.svg
public/globe.svg
public/next.svg
public/vercel.svg
public/window.svg

.vercel
.env*

# 构建期生成产物（generate-agent-feeds.mjs 每次 build 重新生成，不入库）
public/llms.txt
public/llms-full.txt
public/rss/

# preview / temp chrome profiles
_preview_shots/
_cfp_*/

.zcode/

# Python 运行缓存（非项目代码）
Python/
