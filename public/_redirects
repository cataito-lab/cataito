# Cloudflare Pages _redirects
# 替代 src/middleware.ts 的 301 重定向逻辑
# 格式：/from/to/from/to/from [status]
# 参考：https://developers.cloudflare.com/pages/platform/redirects/

# 根路径 → 英文默认
# 已删除 src/app/page.tsx：Next.js 的 redirect() 在 output:'export' 下
# 会生成 __next_error__ HTML（NEXT_REDIRECT marker 静态化后不执行），
# 导致浏览器访问 / 白屏。改为完全依赖 _redirects 的 301 处理。
/ /en 301
/index.html /en/index.html 302

# 无语言前缀的列表页 → 加 /en 前缀
/tools /en/tools 301
/skills /en/skills 301
/mcp /en/mcp 301
/blog /en/blog 301
/tutorials /en/tutorials 301
/ranking /en/ranking 301
/submit /en/submit 301
/about /en/about 301
/privacy /en/privacy 301
/disclaimer /en/disclaimer 301
/editorial-policy /en/editorial-policy 301

# 无语言前缀的详情页 → 加 /en 前缀
# CF Pages _redirects 用 :splat 命名捕获（不是 *，* 是字面量）。
# 参考：https://developers.cloudflare.com/pages/platform/redirects/#rewrites
/tool/:splat /en/tool/:splat 301
/skills/:splat /en/skills/:splat 301
/mcp/:splat /en/mcp/:splat 301
/tutorials/:splat /en/tutorials/:splat 301
/blog/:splat /en/blog/:splat 301
# 旧分类名一步直达最终目标（GSC 诊断 2026-09-11：若先命中下方 /category/:splat
# 会形成 /category/platform → /en/category/platform → /en/category/open-source 二跳链，
# 即 GSC「重定向错误」的来源）。CF Pages 按顺序首条命中，必须放在 splat 规则之前。
/category/platform /en/category/open-source 301
/category/developer /en/category/api-platform 301
/category/:splat /en/category/:splat 301

